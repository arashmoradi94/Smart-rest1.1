generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("EMPLOYEE")
  status       String   @default("OFFLINE")
  onCall       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shifts            Shift[]
  breaks            Break[]
  dinnerAssignments DinnerAssignment[]
  xp                Int                @default(0)
  level             Int                @default(1)
  lastShiftDate     DateTime?
  streakDays        Int                @default(0)
  coinTransactions  CoinTransaction[]
  redemptions       RewardRedemption[]
  pushSubscriptions PushSubscription[]
  sentDirectMessages DirectMessage[] @relation("DirectMessageSender")
  receivedDirectMessages DirectMessage[] @relation("DirectMessageRecipient")
}

model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  readAt      DateTime?

  sender    User @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("DirectMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@index([senderId, createdAt])
}

model Shift {
  id        String    @id @default(cuid())
  userId    String
  startedAt DateTime
  endedAt   DateTime?
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks Break[]

  @@index([userId, status])
}

model Break {
  id                String    @id @default(cuid())
  shiftId           String
  userId            String
  breakIndex        Int
  scheduledStart    DateTime
  scheduledEnd      DateTime
  actualStart       DateTime?
  actualEnd         DateTime?
  durationMinutes   Int?
  startDelayMinutes Int       @default(0)
  endDelayMinutes   Int       @default(0)
  extendMinutes     Int       @default(0)
  groupBreakId      String?
  status            String    @default("SCHEDULED")
  notifiedEarlyAt   DateTime?
  notifiedEndWarnAt DateTime?
  notifiedOverdueAt DateTime?
  kind              String    @default("REGULAR")
  emergencyReason   String?
  emergencyNote     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([userId, status])
  @@index([scheduledStart, scheduledEnd])
  @@index([groupBreakId])
  @@index([kind, status])
}

model DinnerSchedule {
  id              String   @id @default(cuid())
  monthKey        String   @unique
  mode            String   @default("AUTO")
  startTime       String
  endTime         String
  slotMinutes     Int      @default(20)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments DinnerAssignment[]
}

model DinnerAssignment {
  id           String   @id @default(cuid())
  scheduleId   String
  userId       String
  date         String
  startTime    String
  endTime      String
  allocation   String   @default("AUTO")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedule DinnerSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, userId, date])
  @@index([userId, date])
}

model Settings {
  id                        String   @id @default("default")
  workDurationMinutes       Int      @default(60)
  breakDurationMinutes      Int      @default(10)
  maxConcurrentBreaks       Int      @default(5)
  earlyNotificationMinutes  Int      @default(2)
  endNotificationMinutes    Int      @default(2)
  timezone                  String   @default("Asia/Tehran")
  groupBreakEnabled         Boolean  @default(true)
  groupSuggestWindowMinutes Int      @default(10)
  maxGroupBreakLoadRatio    Float    @default(0.3)
  updatedAt                 DateTime @updatedAt
}

model BuddyRequest {
  id          String    @id @default(cuid())
  requesterId String
  addresseeId String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId], map: "sqlite_autoindex_BuddyRequest_2")
}

model BuddyLink {
  id        String   @id @default(cuid())
  aId       String
  bId       String
  createdAt DateTime @default(now())

  @@unique([aId, bId], map: "sqlite_autoindex_BuddyLink_2")
  @@index([bId])
}

model GroupBreak {
  id          String    @id @default(cuid())
  status      String    @default("FORMING")
  createdById String
  startedAt   DateTime?
  createdAt   DateTime  @default(now())

  members GroupBreakMember[]
}

model Announcement {
  id          String   @id @default(cuid())
  authorId    String
  message     String
  audience    String   @default("ALL")
  targetUserIds String  @default("[]")
  createdAt   DateTime @default(now())

  reads AnnouncementRead[]
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

model GroupBreakMember {
  id           String    @id @default(cuid())
  groupBreakId String
  userId       String
  readyAt      DateTime?

  groupBreak GroupBreak @relation(fields: [groupBreakId], references: [id], onDelete: Cascade)

  @@unique([groupBreakId, userId], map: "sqlite_autoindex_GroupBreakMember_2")
  @@index([userId])
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  type      String
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String?
  coinCost    Int
  active      Boolean  @default(true)
  limitCount  Int?
  createdAt   DateTime @default(now())

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id        String   @id @default(cuid())
  rewardId  String
  userId    String
  coinSpent Int
  createdAt DateTime @default(now())

  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
